{
 "slug": "income-tax-bracket-calculator",
 "name": "종합소득세 계산기",
 "title": "종합소득세 계산기 2026 — 과세표준만 넣으면 산출세액과 지방소득세가 나옵니다",
 "desc": "소득세법 제55조 세율표(6~45%, 8구간)와 누진공제액으로 종합소득세 산출세액을 계산하고, 지방소득세 10%를 함께 보여 줍니다. 과세표준 6,000만원이면 864만원입니다.",
 "h1": "종합소득세 계산기 (소득세법 제55조 세율표 기준)",
 "lead": "종합소득 과세표준을 넣으면 산출세액이 나옵니다. 과세표준 6,000만원이면 24% 구간이라 6,000만원 x 24% - 576만원 = 864만원이고, 지방소득세는 그 10%인 86만 4천원입니다. 세액공제와 기납부세액은 반영하지 않은 금액입니다.",
 "basis": "소득세법 제55조 제1항, 국세청 기본세율표(2023년 이후 귀속) 기준 · 줍줍 확인일 2026-11-02",
 "inputs": [
  {
   "id": "base",
   "label": "종합소득 과세표준(원)",
   "type": "number",
   "default": 60000000,
   "min": 0,
   "step": 10000
  }
 ],
 "steps": [
  {
   "id": "tax",
   "label": "종합소득 산출세액",
   "expr": "floor(base <= 14000000 ? base * 6 / 100 : (base <= 50000000 ? base * 15 / 100 - 1260000 : (base <= 88000000 ? base * 24 / 100 - 5760000 : (base <= 150000000 ? base * 35 / 100 - 15440000 : (base <= 300000000 ? base * 38 / 100 - 19940000 : (base <= 500000000 ? base * 40 / 100 - 25940000 : (base <= 1000000000 ? base * 42 / 100 - 35940000 : base * 45 / 100 - 65940000)))))))",
   "fmt": "won"
  },
  {
   "id": "local",
   "label": "지방소득세(산출세액의 10%)",
   "expr": "floor(tax / 10)",
   "fmt": "won"
  },
  {
   "id": "rate",
   "label": "실효세율(%)",
   "expr": "base <= 0 ? 0 : tax / base * 100",
   "fmt": "num"
  }
 ],
 "outputs": [
  {
   "label": "종합소득 산출세액",
   "expr": "tax",
   "fmt": "won"
  },
  {
   "label": "지방소득세(10%)",
   "expr": "local",
   "fmt": "won"
  },
  {
   "label": "합계",
   "expr": "tax + local",
   "fmt": "won"
  },
  {
   "label": "산출세액 기준 실효세율(%)",
   "expr": "rate",
   "fmt": "num"
  }
 ],

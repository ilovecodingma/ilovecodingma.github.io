 "desc": "2026년 요율로 4대보험 근로자 부담분을 계산합니다. 국민연금 4.75%와 기준소득월액 하한 41만 원·상한 659만 원, 건강보험, 장기요양, 고용보험을 월 보수와 비과세액만으로 구합니다.",
 "h1": "4대보험 계산기 (2026년 근로자 부담분)",
 "lead": "월 보수 300만 원(비과세 없음)이면 근로자 부담분은 국민연금 142,500원, 건강보험 107,850원, 장기요양 14,171원, 고용보험 27,000원으로 합계 291,521원입니다. 산재보험은 사업주가 전액 내므로 넣지 않았습니다.",
 "basis": "국민연금법 부칙 제4조·보건복지부고시 제2026-31호, 국민건강보험법 시행령 제44조·건강보험료 상한·하한 고시, 고용보험 및 산재보험 보험료징수법 시행령 제12조 기준 · 줍줍 확인일 2026-11-02",
 "inputs": [
  {
   "id": "income",
   "label": "월 보수(세전, 원)",
   "type": "number",
   "default": 3000000,
   "min": 0,
   "step": 10000
  },
  {
   "id": "taxfree",
   "label": "월 비과세액(식대 등, 원)",
   "type": "number",
   "default": 0,
   "min": 0,
   "step": 10000
  }
 ],
 "steps": [
  {
   "id": "pay",
   "label": "보험료 부과 기준 보수(월 보수 - 비과세)",
   "expr": "max(0, income - taxfree)",
   "fmt": "won"
  },
  {
   "id": "base",
   "label": "국민연금 기준소득월액(천 원 미만 버림, 41만~659만 원)",
   "expr": "min(6590000, max(410000, floor(pay / 1000) * 1000))",
   "fmt": "won"
  },
  {
   "id": "nps",
   "label": "국민연금(4.75%)",
   "expr": "pay <= 0 ? 0 : floor(base * 475 / 100000) * 10",
   "fmt": "won"
  },
  {
   "id": "hi_total",
   "label": "건강보험료 전체(7.19%, 월 하한 20,160원·상한 9,183,480원)",
   "expr": "pay <= 0 ? 0 : min(9183480, max(20160, floor(pay * 719 / 10000)))",
   "fmt": "won"
  },
  {
   "id": "hi",
   "label": "건강보험(근로자 절반)",
   "expr": "floor(hi_total / 2)",
   "fmt": "won"
  },
  {
   "id": "ltc",
   "label": "장기요양(건강보험료의 13.14%, 근로자 절반)",
   "expr": "floor(floor(hi_total * 1314 / 10000) / 2)",
   "fmt": "won"
  },
  {
   "id": "ei",
   "label": "고용보험(실업급여 0.9%)",
   "expr": "floor(pay * 9 / 1000)",
   "fmt": "won"
  },
  {
   "id": "total",
   "label": "근로자 부담 합계",
   "expr": "nps + hi + ltc + ei",
   "fmt": "won"
  }
 ],
 "outputs": [
  {
   "label": "국민연금",
   "expr": "nps",
   "fmt": "won"
  },
  {
   "label": "건강보험",
   "expr": "hi",
   "fmt": "won"
  },
  {
   "label": "장기요양",

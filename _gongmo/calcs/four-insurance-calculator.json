   "fmt": "won"
  },
  {
   "label": "고용보험",
   "expr": "ei",
   "fmt": "won"
  },
  {
   "label": "근로자 부담 합계",
   "expr": "total",
   "fmt": "won"
  },
  {
   "label": "공제 후 금액(월 보수 - 합계)",
   "expr": "income - total",
   "fmt": "won"
  }
 ],

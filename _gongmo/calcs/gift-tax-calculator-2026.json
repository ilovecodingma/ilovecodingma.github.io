     1
    ]
   ],
   "default": 0,
   "group": "공제와 할증"
  },
  {
   "id": "prior",
   "label": "10년 안에 같은 사람에게서 이미 받은 증여재산(원, 증여자가 직계존속이면 그 배우자 포함)",
   "type": "number",

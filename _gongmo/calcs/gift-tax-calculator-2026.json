 "steps": [
  {
   "id": "limit",
   "label": "증여재산공제 한도",
   "expr": "rel <= 1 ? 600000000 : (rel <= 2 ? (minor > 0 ? 20000000 : 50000000) : (rel <= 3 ? 50000000 : 10000000))",
   "fmt": "won"
  },
  {
   "id": "netg",
   "label": "증여재산가액 - 인수 채무",
   "expr": "max(0, gift - debt)",
   "fmt": "won"
  },
  {
   "id": "padd",
   "label": "10년 안에 합산하는 이전 증여",
   "expr": "prior >= 10000000 ? prior : 0",
   "fmt": "won"
  },
  {
   "id": "used",
   "label": "이전에 이미 쓴 증여재산공제",
   "expr": "min(prior, limit)",
   "fmt": "won"
  },
  {
   "id": "taxable",
   "label": "증여세 과세가액",
   "expr": "netg + padd",
   "fmt": "won"
  },
  {
   "id": "ded1",
   "label": "이번에 남은 증여재산공제",
   "expr": "max(0, limit - used)",
   "fmt": "won"
  },
  {
   "id": "wedleft",
   "label": "남은 혼인·출산 공제",
   "expr": "rel >= 2 ? (rel <= 2 ? (wed > 0 ? max(0, 100000000 - wedused) : 0) : 0) : 0",
   "fmt": "won"
  },
  {
   "id": "totded",
   "label": "공제 합계",
   "expr": "min(taxable, ded1 + wedleft)",
   "fmt": "won"
  },
  {
   "id": "base0",
   "label": "공제 후 금액",
   "expr": "taxable - totded",
   "fmt": "won"
  },
  {
   "id": "base",
   "label": "증여세 과세표준(50만원 미만이면 0)",
   "expr": "base0 < 500000 ? 0 : base0",
   "fmt": "won"
  },
  {
   "id": "tax",
   "label": "증여세 산출세액",
   "expr": "floor(base <= 100000000 ? base * 10 / 100 : (base <= 500000000 ? base * 20 / 100 - 10000000 : (base <= 1000000000 ? base * 30 / 100 - 60000000 : (base <= 3000000000 ? base * 40 / 100 - 160000000 : base * 50 / 100 - 460000000))))",
   "fmt": "won"
  },
  {
   "id": "surch",
   "label": "세대를 건너뛴 증여 할증",
   "expr": "rel >= 2 ? (rel <= 2 ? (skip > 0 ? floor(tax * (minor > 0 ? (gift > 2000000000 ? 40 : 30) : 30) / 100) : 0) : 0) : 0",
   "fmt": "won"
  },
  {
   "id": "pbase",
   "label": "이전 증여의 과세표준(증여 당시 공제를 한도까지 받은 것으로 가정)",
   "expr": "padd > 0 ? max(0, padd - min(prior, limit)) : 0",
   "fmt": "won"
  },
  {
   "id": "ptax",
   "label": "이전 증여의 산출세액",
   "expr": "floor(pbase <= 100000000 ? pbase * 10 / 100 : (pbase <= 500000000 ? pbase * 20 / 100 - 10000000 : (pbase <= 1000000000 ? pbase * 30 / 100 - 60000000 : (pbase <= 3000000000 ? pbase * 40 / 100 - 160000000 : pbase * 50 / 100 - 460000000))))",
   "fmt": "won"
  },
  {
   "id": "pcredit",
   "label": "납부세액공제",
   "expr": "base > 0 ? min(ptax, floor(tax * pbase / base)) : 0",
   "fmt": "won"
  },
  {
   "id": "filedcred",
   "label": "신고세액공제(3%)",
   "expr": "filed > 0 ? floor((tax + surch - pcredit) * 3 / 100) : 0",
   "fmt": "won"
  },
  {
   "id": "pay",
   "label": "납부할 증여세",
   "expr": "max(0, tax + surch - pcredit - filedcred)",
   "fmt": "won"
  },
  {
   "id": "rate",
   "label": "증여재산가액 대비 납부세액(%)",
   "expr": "gift > 0 ? pay / gift * 100 : 0",
   "fmt": "pct"
  }
 ],
 "outputs": [

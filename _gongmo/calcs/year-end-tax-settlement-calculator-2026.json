 "steps": [
  {
   "id": "workded",
   "label": "근로소득공제",
   "expr": "floor(min(20000000, pay <= 5000000 ? pay * 70 / 100 : (pay <= 15000000 ? 3500000 + (pay - 5000000) * 40 / 100 : (pay <= 45000000 ? 7500000 + (pay - 15000000) * 15 / 100 : (pay <= 100000000 ? 12000000 + (pay - 45000000) * 5 / 100 : 14750000 + (pay - 100000000) * 2 / 100)))))",
   "fmt": "won"
  },
  {
   "id": "workinc",
   "label": "근로소득금액",
   "expr": "max(0, pay - workded)",
   "fmt": "won"
  },
  {
   "id": "basic",
   "label": "기본공제",
   "expr": "people * 1500000",
   "fmt": "won"
  },
  {
   "id": "minuse",
   "label": "최저사용금액(총급여의 25%)",
   "expr": "floor(pay * 25 / 100)",
   "fmt": "won"
  },
  {
   "id": "kk",
   "label": "문화체육 사용분(총급여 7천만원 이하만 따로 셈)",
   "expr": "pay <= 70000000 ? culture : 0",
   "fmt": "won"
  },
  {
   "id": "total",
   "label": "카드 등 사용액 합계",
   "expr": "cc + dc + bus + market + kk",
   "fmt": "won"
  },
  {
   "id": "sub",
   "label": "차감하는 금액",
   "expr": "cc >= minuse ? minuse * 15 / 100 : (cc + dc + kk >= minuse ? cc * 15 / 100 + (minuse - cc) * 30 / 100 : cc * 15 / 100 + (dc + kk) * 30 / 100 + (minuse - cc - dc - kk) * 40 / 100)",
   "fmt": "won"
  },
  {
   "id": "ded0",
   "label": "카드 등 공제(한도 적용 전)",
   "expr": "total > minuse ? floor(market * 40 / 100 + bus * 40 / 100 + kk * 30 / 100 + dc * 30 / 100 + cc * 15 / 100 - sub) : 0",
   "fmt": "won"
  },
  {
   "id": "cap",
   "label": "카드 등 공제 기본 한도",
   "expr": "kids <= 0 ? (pay <= 70000000 ? 3000000 : 2500000) : (pay <= 70000000 ? (kids <= 1 ? 3500000 : 4000000) : (kids <= 1 ? 2750000 : 3000000))",
   "fmt": "won"
  },
  {
   "id": "exbase",
   "label": "한도 초과 시 추가로 인정하는 한도",
   "expr": "min(pay <= 70000000 ? 3000000 : 2000000, floor(market * 40 / 100) + floor(bus * 40 / 100) + (pay <= 70000000 ? floor(kk * 30 / 100) : 0))",
   "fmt": "won"
  },
  {
   "id": "cardded",
   "label": "카드 등 소득공제",
   "expr": "min(ded0, cap) + min(max(0, ded0 - cap), exbase)",
   "fmt": "won"
  },
  {
   "id": "limited",
   "label": "종합한도 적용 후(카드 등 + 기타 소득공제)",
   "expr": "min(25000000, cardded + other)",
   "fmt": "won"
  },
  {
   "id": "incded",
   "label": "소득공제 합계",
   "expr": "basic + insure + limited",
   "fmt": "won"
  },
  {
   "id": "base",
   "label": "종합소득 과세표준",
   "expr": "max(0, workinc - incded)",
   "fmt": "won"
  },
  {
   "id": "tax",
   "label": "산출세액",
   "expr": "floor(base <= 14000000 ? base * 6 / 100 : (base <= 50000000 ? base * 15 / 100 - 1260000 : (base <= 88000000 ? base * 24 / 100 - 5760000 : (base <= 150000000 ? base * 35 / 100 - 15440000 : (base <= 300000000 ? base * 38 / 100 - 19940000 : (base <= 500000000 ? base * 40 / 100 - 25940000 : (base <= 1000000000 ? base * 42 / 100 - 35940000 : base * 45 / 100 - 65940000)))))))",
   "fmt": "won"
  },
  {
   "id": "wraw",
   "label": "근로소득세액공제(한도 적용 전)",
   "expr": "tax <= 1300000 ? tax * 55 / 100 : 715000 + (tax - 1300000) * 30 / 100",
   "fmt": "won"
  },
  {
   "id": "wcap",
   "label": "근로소득세액공제 한도",
   "expr": "pay <= 33000000 ? 740000 : (pay <= 70000000 ? max(660000, 740000 - (pay - 33000000) * 8 / 1000) : (pay <= 120000000 ? max(500000, 660000 - (pay - 70000000) / 2) : max(200000, 500000 - (pay - 120000000) / 2)))",
   "fmt": "won"
  },
  {
   "id": "wcred",
   "label": "근로소득세액공제",
   "expr": "floor(min(wraw, wcap))",
   "fmt": "won"
  },
  {
   "id": "kidcred",
   "label": "자녀세액공제",
   "expr": "kids <= 0 ? 0 : (kids <= 1 ? 250000 : (kids <= 2 ? 550000 : 550000 + (kids - 2) * 400000))",
   "fmt": "won"
  },
  {
   "id": "penbase",
   "label": "연금계좌 공제 대상 납입액",
   "expr": "min(irp + min(pension, 6000000), 9000000)",
   "fmt": "won"
  },
  {
   "id": "pencred",
   "label": "연금계좌세액공제",
   "expr": "floor(penbase * (pay <= 55000000 ? 15 : 12) / 100)",
   "fmt": "won"
  },
  {
   "id": "stdcred",
   "label": "표준세액공제 또는 특별세액공제",
   "expr": "max(130000, special)",
   "fmt": "won"
  },
  {
   "id": "credits",
   "label": "세액공제 합계",
   "expr": "wcred + kidcred + pencred + stdcred",
   "fmt": "won"
  },
  {
   "id": "final",
   "label": "결정세액",
   "expr": "max(0, tax - credits)",
   "fmt": "won"
  },
  {
   "id": "diff",
   "label": "기납부세액 - 결정세액",
   "expr": "paid - final",
   "fmt": "won"
  },
  {
   "id": "refund",
   "label": "환급 예상액",
   "expr": "max(0, diff)",
   "fmt": "won"
  },
  {
   "id": "owe",
   "label": "추가 납부 예상액",
   "expr": "max(0, 0 - diff)",
   "fmt": "won"
  }
 ],
 "outputs": [

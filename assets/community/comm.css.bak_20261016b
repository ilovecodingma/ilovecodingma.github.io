.cm-acct{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:13px;flex:0 0 auto}
.cm-acct button,.btn2{font:inherit;font-size:13px;font-weight:700;border:0;border-radius:10px;padding:6px 12px;background:var(--pri);color:#fff;cursor:pointer}
.btn2.ghost{background:var(--pbg);color:var(--pri)}
.cm-modal{position:fixed;inset:0;z-index:100;background:rgba(15,10,40,.5);display:grid;place-items:center;padding:16px}
.cm-box{position:relative;width:min(380px,100%);background:var(--card);border-radius:20px;padding:20px;box-shadow:0 20px 50px rgba(0,0,0,.3)}
.cm-box h3{margin:0 0 4px}.cm-box input{width:100%;margin:6px 0;font:inherit;padding:10px 12px;border:1px solid var(--bd);border-radius:12px;background:var(--bg);color:var(--tx)}
.cm-x{position:absolute;right:12px;top:10px;border:0;background:none;font-size:18px;cursor:pointer;color:var(--mu)}
.cm-row{display:flex;gap:8px;margin:8px 0}.cm-row button{flex:1;padding:10px}
.cm-err{color:var(--red);font-size:13px;min-height:1em;margin:4px 0}
#cm-board{margin-top:30px}.cm-head{display:flex;align-items:center;justify-content:space-between}.cm-head h2{margin:0}
.cm-form{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:14px;margin:12px 0}
.cm-form input,.cm-form textarea,.cm-form select{width:100%;font:inherit;margin:5px 0;padding:9px 11px;border:1px solid var(--bd);border-radius:10px;background:var(--bg);color:var(--tx)}
.cm-kinds{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.cm-kinds select{width:auto}
.cm-list{list-style:none;padding:0;margin:12px 0;display:grid;gap:10px}
.cm-post{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:14px;box-shadow:var(--sh)}
.cm-post h3{margin:6px 0 4px;font-size:15.5px}.cm-body{margin:4px 0;white-space:pre-wrap;font-size:14.5px}
.cm-meta{display:flex;gap:8px;align-items:center;font-size:12.5px;color:var(--mu);flex-wrap:wrap}
.cm-k{font-weight:800;border-radius:6px;padding:0 7px;background:var(--pbg);color:var(--pri)}.cm-k.k-qna{background:var(--gbg);color:#b45309}.cm-k.k-tip{background:var(--okbg);color:var(--ok)}
.cm-star{color:#f59e0b;letter-spacing:1px}.cm-on{font-size:13px;text-decoration:none}
.cm-acts{display:flex;gap:6px;margin-top:6px}.cm-acts button{font:inherit;font-size:12.5px;border:1px solid var(--bd);background:var(--card);color:var(--mu);border-radius:999px;padding:3px 10px;cursor:pointer}
.cm-cms{margin-top:8px;border-top:1px solid var(--bd);padding-top:8px}.cm-c{font-size:13.5px;margin:4px 0}.cm-c small{color:var(--mu)}
.cm-cf{display:flex;gap:6px;margin-top:6px}.cm-cf input{flex:1;font:inherit;font-size:13.5px;padding:7px 10px;border:1px solid var(--bd);border-radius:10px;background:var(--bg);color:var(--tx)}
.cm-empty{color:var(--mu);text-align:center;padding:18px}
